{
    "redirects": [
        {
            "source": "/store/index.html",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/store/index",
            "destination": "/",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/a",
            "destination": "/admin/login.html"
        },
        {
            "source": "/portal",
            "destination": "/admin/login.html"
        },
        {
            "source": "/admin",
            "destination": "/admin/login.html"
        },
        {
            "source": "/admin/dashboard",
            "destination": "/admin/dashboard.html"
        },
        {
            "source": "/dashboard.html",
            "destination": "/admin/dashboard.html"
        },
        {
            "source": "/admin/:path*",
            "destination": "/admin/:path*"
        },
        {
            "source": "/store/:path*",
            "destination": "/store/:path*"
        },
        {
            "source": "/shared/:path*",
            "destination": "/shared/:path*"
        },
        {
            "source": "/images/:path*",
            "destination": "/images/:path*"
        },
        {
            "source": "/((?!admin|store|shared|images).*)",
            "destination": "/index.html"
        }
    ]
}